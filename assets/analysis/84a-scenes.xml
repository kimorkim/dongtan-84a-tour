     <action name="add_top_menus" autorun="onstart">
    for(
      <!-- startactions -->
      set(i, 0);
      ,
      <!-- condition -->
      i LT topmenu_contents.count
      ,
      <!-- nextactions -->
      inc(i);
      ,
      <!-- loopactions -->
      set(text_layer_name, calc('btn_'+i));
      addlayer(get(text_layer_name));
      layer[get(text_layer_name)].loadstyle(style_menu_text);
      set(layer[get(text_layer_name)],
        i           = get(i),
        parent      = top_menus_scroller,
        html        = get(topmenu_contents[get(i)].html),
        x           = calc(i*get(layer[get(text_layer_name)].width)),
        linkedscene = get(topmenu_contents[get(i)].linkedscene)
              );
    );
    set(layer[top_menus_scroller].width, calc((topmenu_contents.count)*style[style_menu_text].width));
    tween(easeoutbounce);
  </action>

<action name="detect_scenes">
    for(
      <!-- startactions -->
      set(i, 0);
      ,
      <!-- condition -->
      i LT topmenu_contents.count
      ,
      <!-- nextactions -->
      inc(i);
      ,
      <!-- loopactions -->
      set(text_layer_name, calc('btn_'+i)); 
      if(
        <!-- condition -->
        xml.scene == layer[get(text_layer_name)].linkedscene
        ,
        <!-- then-actions -->
        set(layer[get(text_layer_name)].bgshadow, '0 6 0 0xa1826d 1');
                ,
        <!-- else-actions -->
        set(layer[get(text_layer_name)].bgshadow, '');
      );
    );
  </action>

   

      <action name="startup" autorun="onstart"> if(startscene === null OR !scene[get(startscene)], copy(startscene,scene[0].name); ); loadscene(get(startscene), null, MERGE); if(startactions !== null, startactions() ); skin_setup_littleplanetintro2(); tween(global.plugin[pp_blur].range, 40.0); addlayer(popup_bg); layer[popup_bg].loadstyle(popup_bg); set(layer[poster].parent, popup_bg); 
   </action>

<action name="close_poster"> tween(global.plugin[pp_blur].range, 0.0, 0.7); tween(layer[popup_bg].alpha, 0, 0.7,,removelayer(popup_bg, true); skin_setup_littleplanetintro3();); 
</action>

<action name="skin_setup_littleplanetintro2" scope="local">
 skin_hideskin(instant); set(global.lpinfo, scene=get(xml.scene), hlookat=get(view.hlookat), vlookat=get(view.vlookat), fov=get(view.fov), fovmax=get(view.fovmax), limitview=get(view.limitview) ); set(view, fovmax=170, limitview=lookto, vlookatmin=90, vlookatmax=90); lookat(calc(global.lpinfo.hlookat - 0), 90, 150, 1, 0, 0); 
</action>

<action name="skin_setup_littleplanetintro3" scope="local"> 
	delayedcall(0.1, if(lpinfo.scene === xml.scene, set(control.usercontrol, off); set(view, limitview=get(lpinfo.limitview), vlookatmin=null, view.vlookatmax=null); tween(view.hlookat|view.vlookat|view.fov|view.distortion, calc('' + lpinfo.hlookat + '|' + lpinfo.vlookat + '|' + lpinfo.fov + '|' + 0.0), 3.0, easeOutQuad); delayedcall(3.0, set(control.usercontrol, all); tween(view.fovmax, get(lpinfo.fovmax)); skin_deeplinking_update_url(); delete(global.lpinfo); skin_showskin(); if(skin_settings.thumbs AND skin_settings.thumbs_opened, skin_showthumbs() ); ); , delete(global.lpinfo); ); ); 
</action>

